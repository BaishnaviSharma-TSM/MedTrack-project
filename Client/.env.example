# API base URL (required when EXPO_PUBLIC_USE_MOCK_DATA=false)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Data source toggle:
#   true  → use in-app mock patients/visits (no server required)
#   false → fetch from NestJS API (server must be running; login with doctor@medtrack.com)
EXPO_PUBLIC_USE_MOCK_DATA=true

EXPO_PUBLIC_LOG_LEVEL=debug
